   "source": [
    "from pathlib import Path\n\nfrom matplotlib import pyplot as plt\nimport numpy as np\nfrom vascx.faz.retina import FAZRetina\n\nfrom rtnls_enface.utils.data_loading import open_mask\nfrom vascx.faz.features.caliber import Caliber\nfrom vascx.faz.features.tortuosity import Tortuosity\nfrom vascx.faz.features.vascular_densities import VascularDensity\nfrom rtnls_enface.utils.plotting import plot_columns, plot_rows\nfrom rtnls_enface.grids.etdrs import Ring\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ds_path = Path('/mnt/oogergo/eyened/sinergia/faz_samples/FAZ')\nimages_paths = sorted(list(ds_path.glob('*_OCTA.png')))\nmasks_paths = sorted(list(ds_path.glob('*_AV_Map.png')))\nfaz_paths = sorted(list(ds_path.glob('*_FAZ.png')))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def av_loader(fpath, *args):\n    im = open_mask(fpath)\n\n    if len(im.shape) == 3:\n        im = im[..., 0]\n\n    return {\n        \"arteries\": (im == 127),\n        \"veins\": (im == 255),\n    }\n\n\ndef load_retina(index):\n    return FAZRetina.from_file(\n        av_path=masks_paths[index],\n        faz_path=faz_paths[index],\n        image_path=images_paths[index],\n        av_loader=av_loader,\n    )\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ret = load_retina(1)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from vascx.faz.features.faz_params import FazParameter, FazParameterType\n\nfeature = FazParameter(FazParameterType.PerimeterLength)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots()\nfeature.plot(ax, ret.arteries)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axs = plt.subplots(1, 4, figsize=(16, 4))\nVascularDensity(grid_field=Ring.Inner).plot(axs[0], ret.arteries)\nVascularDensity(grid_field=Ring.Inner).plot(axs[1], ret.veins)\nVascularDensity(grid_field=Ring.Outer).plot(axs[2], ret.arteries)\nVascularDensity(grid_field=Ring.Outer).plot(axs[3], ret.veins)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_column(axs, col, fig):\n    ret = load_retina(col)\n    Caliber(min_numpoints=3).plot(axs[0], ret.veins)\n    Tortuosity(min_numpoints=5).plot(axs[1], ret.veins)\n    VascularDensity().plot(axs[2], ret.veins)\n\nplot_columns(plot_column, 3, 4)\n"
   ]
  }
